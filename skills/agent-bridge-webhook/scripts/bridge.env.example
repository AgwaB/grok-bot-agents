# Copy to ~/.config/grok-bot-agents/bridge.env and `chmod 600` it. Values come from the routine panel.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_HEADER=
GROKBOT_WEBHOOK_KEY=
# Return channel for `grok-send-task --wait` (box over Tailscale). The bot fills these via --import-result-env.
GROKBOT_RESULT_URL=
GROKBOT_RESULT_TOKEN=
